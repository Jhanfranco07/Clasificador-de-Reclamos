{
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "integration/smartclaim-cinco-roles-rag": false
    }
  },
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
